{
  "name": "meu-socio-push",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "socio-push",
      "database_id": "REPLACE_WITH_DATABASE_ID"
    }
  ]
}
